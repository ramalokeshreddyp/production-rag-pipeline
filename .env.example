# ==============================================================================
# Production-Ready RAG Pipeline Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
UI_PORT=8501

# Embedding Configuration
# Options: openai, huggingface, mock
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=1536

# Vector Database Configuration
# Options: chroma, faiss
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_knowledge_base
FAISS_INDEX_DIR=./data/faiss_index

# Chunking Strategy Configuration
# Options: fixed, sentence_aware, paragraph_aware, sliding_window
CHUNKING_STRATEGY=sentence_aware
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=80

# Retrieval & Search Configuration
TOP_K=4
RETRIEVAL_MODE=hybrid
# Options: dense, bm25, hybrid
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
ENABLE_RERANKING=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=15

# LLM Generation Configuration
# Options: openai, huggingface, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
